{
  "name": "@axiom-agent/example-coding-agent-gui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "dev:renderer:tauri": "vite --mode tauri",
    "build": "pnpm build:renderer:tauri && pnpm build:sidecar",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:renderer:tauri": "tsc -p tsconfig.json && vite build --mode tauri",
    "build:sidecar": "bun build --compile ./server.mjs --outfile ./src-tauri/binaries/agent-server-x86_64-pc-windows-msvc.exe",
    "start": "node server.mjs",
    "tauri": "tauri",
    "test": "node --test"
  },
  "dependencies": {
    "@axiom-agent/coding-agent": "workspace:*",
    "@axiom-agent/core": "workspace:*",
    "@axiom-agent/openai-compatible": "workspace:*",
    "@axiom-agent/session-jsonl": "workspace:*",
    "@axiom-agent/trace-jsonl": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.0.0"
  }
}
