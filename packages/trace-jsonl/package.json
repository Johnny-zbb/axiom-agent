{
  "name": "@axiom-agent/trace-jsonl",
  "version": "0.1.0",
  "description": "Append-only JSONL event traces for Axiom Agent runs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @axiom-agent/core build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @axiom-agent/core build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "@axiom-agent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
